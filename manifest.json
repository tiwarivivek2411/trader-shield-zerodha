{
  "manifest_version": 3,
  "name": "TraderShield - Zerodha Discipline Guard",
  "version": "1.0.0",
  "description": "Enforces behavioral limiters on Zerodha Kite: blocks fund additions during market hours and prevents 0-DTE option trading.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "*://kite.zerodha.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://kite.zerodha.com/*"],
      "js": ["utils/expiry_parser.js", "content_scripts/kite_interceptor.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_scripts/page_interceptor.js"],
      "matches": ["*://kite.zerodha.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TraderShield - Zerodha Discipline Guard"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
